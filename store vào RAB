#include <iostream>
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <math.h>
#include <string.h>

using namespace std;

#define N_hc     4
#define D_MODEL  4096
#define RAB_SIZE 8   // số slot trong RAB

typedef struct {
    uint16_t bits;
} bf16;

bf16 fp32_to_bf16(float f) {
    uint32_t fp32_bits;
    memcpy(&fp32_bits, &f, sizeof(fp32_bits));
    uint16_t sign = (fp32_bits & 0x80000000u) >> 16;
    uint16_t expo = (fp32_bits & 0x7F800000u) >> 16;
    uint16_t mant = (fp32_bits & 0x007F0000u) >> 16;
    bf16 b = { (uint16_t)(sign | expo | mant) };
    return b;
}

float bf16_to_fp32(bf16 b) {
    uint32_t sign     = ((uint32_t)(b.bits & 0x8000)) << 16;
    uint32_t exponent = ((uint32_t)(b.bits & 0x7F80)) << 16;
    uint32_t mantissa = ((uint32_t)(b.bits & 0x007F)) << 16;
    uint32_t fp32_bits = sign | exponent | mantissa;
    float result;
    memcpy(&result, &fp32_bits, sizeof(result));
    return result;
}

// ===================== RAB =====================
typedef struct {
    bf16 data[D_MODEL];
    bool valid;
} RAB_Entry;

typedef struct {
    RAB_Entry slots[RAB_SIZE];
    int head;               // vị trí ghi tiếp theo
} RAB;

void rab_init(RAB* rab) {
    memset(rab, 0, sizeof(RAB));
    rab->head = 0;
}

// Trả về con trỏ tới slot hiện tại rồi tăng head (ring buffer)
bf16* rab_alloc(RAB* rab) {
    RAB_Entry* e = &rab->slots[rab->head];
    e->valid = true;
    rab->head = (rab->head + 1) % RAB_SIZE;
    return e->data;
}

// Đọc lại kết quả từ slot (idx: 0..RAB_SIZE-1)
const bf16* rab_read(const RAB* rab, int idx) {
    return rab->slots[idx].valid ? rab->slots[idx].data : NULL;
}

// ===================== MATMUL + STORE =====================
// Tính Y = A * X và ghi trực tiếp vào RAB (không cần buffer tạm)
void matmul_A_X_store(const float A_l[N_hc],
                      const bf16 X_l[N_hc][D_MODEL],
                      RAB* rab) {
    bf16* Y_l = rab_alloc(rab);   // lấy slot trong RAB làm đích ghi
    for (int j = 0; j < D_MODEL; j++) {
        float sum = 0.0f;
        for (int i = 0; i < N_hc; i++) {
            sum += A_l[i] * bf16_to_fp32(X_l[i][j]);
        }
        Y_l[j] = fp32_to_bf16(sum);
    }
}

// ===================== MAIN =====================
int main() {
    float A_l[N_hc] = { 0.55f, 0.48f, 0.62f, 0.57f };

    static bf16 X_l[N_hc][D_MODEL];   // static để tránh tràn stack
    RAB rab;
    rab_init(&rab);

    for (int i = 0; i < N_hc; i++)
        for (int j = 0; j < D_MODEL; j++)
            X_l[i][j] = fp32_to_bf16((float)(rand() % 100) / 10.0f);

    matmul_A_X_store(A_l, X_l, &rab);

    // In thử 10 phần tử đầu của slot vừa ghi
    const bf16* Y = rab_read(&rab, 0);
    for (int j = 0; j < 10; ++j)
        cout << bf16_to_fp32(Y[j]) << '\n';

    return 0;
}
